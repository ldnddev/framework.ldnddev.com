    {
      "id": "page-layouts-footer-large",
      "slug": "layouts/footer-large",
      "slug_locked": false,
      "head": {
        "title": "Footer large",
        "meta_title": "Footer large | ldnddev Framework",
        "meta_description": "This footer variant supports multi-level navigation menus, a newsletter signup form, company info (including logo, address, phone, and email), social media...",
        "canonical_url": null,
        "robots": "index, follow",
        "schema_type": "WebPage",
        "og_title": null,
        "og_description": null,
        "og_image": null
      },
      "nodes": [
        {
          "node_type": "section",
          "id": "page-layouts-footer-large-section-1",
          "section_title": null,
          "section_class": "-full-lg",
          "item_box_class": "l-box",
          "sal": "no-animation",
          "columns": [
            {
              "id": "page-layouts-footer-large-section-1-column-1",
              "width_class": "dd-u-1-1",
              "components": [
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "# Footer large"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "## Overview\n\nThis footer variant supports multi-level navigation menus, a newsletter signup form, company info (including logo, address, phone, and email), social media links, and a copyright section."
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "### Preview"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "<div class=\"dd-example\">\n<footer class=\"dd-footer\">\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__navigation navigation -footer-menu dd-u-1-1 dd-u-lg-18-24 l-box\">\n      <nav class=\"navigation\" role=\"navigation\" itemscope itemtype=\"https://schema.org/SiteNavigationElement\" aria-label=\"Footer navigation\">\n        <ul class=\"menu\">\n          <li class=\"menu-item\">First Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Second Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Third Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Forth Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n        </ul>\n      </nav>\n    </div>\n    <div class=\"dd-footer__newsletter dd-u-1-1 dd-u-lg-6-24 l-box\">\n      <div class=\"newsletter-signup\">\n        <div class=\"newsletter-signup__header\">Sign up</div>\n        <form class=\"newsletter-signup__form\">\n          <label for=\"email\" id=\"\">Your email address</label>\n          <input id=\"email\" name=\"email\" type=\"email\" />\n          <button class=\"dd-button\" type=\"submit\">Sign up</button>\n        </form>\n      </div>\n    </div>\n  </div>\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__company-info dd-u-1-1 dd-u-lg-16-24 l-box\">\n      <div class=\"dd-g\">\n        <div class=\"dd-footer__logo dd-u-6-24\">\n          <img class=\"dd-img\" src=\"/assets/imgs/logo-box-solid.svg\" alt=\"ldnddev, LLC.\" />\n        </div>\n        <div class=\"dd-footer__name dd-u-18-24 l-box\">{{ Name Of Company }}</div>\n        <div class=\"dd-footer__contact dd-u-1-1 l-box\">\n          <div class=\"dd-footer__address dd-u-1-1\">\n            <address>{{ Company Address }}</address>\n          </div>\n          <div class=\"dd-footer__phone dd-u-1-1\">\n            <a href=\"tel:555-555-5555\" title=\"Call 555-555-5555\">555-555-5555</a>\n          </div>\n          <div class=\"dd-footer__email dd-u-1-1\">\n            <a href=\"mailto:info@company.com\" title=\"Send email to info@company.com\">info@company.com</a>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"dd-footer__navigation navigation -social-menu dd-u-1-1 dd-u-lg-8-24 l-box\">\n      <nav class=\"navigation\" role=\"navigation\" itemscope itemtype=\"https://schema.org/SiteNavigationElement\" aria-label=\"Footer navigation\">\n        <ul class=\"menu\">\n          <li class=\"menu-item\">\n            <a href=\"https://www.facebook.com/\" itemprop=\"url\" class=\"-facebook\"><span class=\"visually-hidden\">Facebook</span></a>\n          </li>\n          <li class=\"menu-item\">\n            <a href=\"https://www.instagram.com/\" itemprop=\"url\" class=\"-instagram\"><span class=\"visually-hidden\">Instagram</span></a>\n          </li>\n          <li class=\"menu-item\">\n            <a href=\"https://twitter.com/\" itemprop=\"url\" class=\"-x\"><span class=\"visually-hidden\">Twitter</span></a>\n          </li>\n        </ul>\n      </nav>\n    </div>\n  </div>\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__copyright dd-u-1-1\">\n      <div class=\"l-box\">\n        {{ copyright goes here }}\n      </div>\n    </div>\n  </div>\n</footer>\n</div>"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "### Code"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "```html\n<footer class=\"dd-footer\">\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__navigation navigation -footer-menu dd-u-1-1 dd-u-lg-18-24 l-box\">\n      <nav class=\"navigation\" role=\"navigation\" itemscope itemtype=\"https://schema.org/SiteNavigationElement\" aria-label=\"Footer navigation\">\n        <ul class=\"menu\">\n          <li class=\"menu-item\">First Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Second Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Third Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n          <li class=\"menu-item\">Forth Menu\n            <ul class=\"sub-menu\">\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n              <li class=\"menu-item\">\n                <a href=\"#\" class=\"navigation__link\">Link</a>\n              </li>\n            </ul>\n          </li>\n        </ul>\n      </nav>\n    </div>\n    <div class=\"dd-footer__newsletter dd-u-1-1 dd-u-lg-6-24 l-box\">\n      <div class=\"newsletter-signup\">\n        <div class=\"newsletter-signup__header\">Sign up</div>\n        <form class=\"newsletter-signup__form\">\n          <label for=\"email\" id=\"\">Your email address</label>\n          <input id=\"email\" name=\"email\" type=\"email\" />\n          <button class=\"dd-button\" type=\"submit\">Sign up</button>\n        </form>\n      </div>\n    </div>\n  </div>\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__company-info dd-u-1-1 dd-u-lg-16-24 l-box\">\n      <div class=\"dd-g\">\n        <div class=\"dd-footer__logo dd-u-6-24\">\n          <img class=\"dd-img\" src=\"/assets/imgs/logo-box-solid.svg\" alt=\"ldnddev, LLC.\" />\n        </div>\n        <div class=\"dd-footer__name dd-u-18-24 l-box\">{{ Name Of Company }}</div>\n        <div class=\"dd-footer__contact dd-u-1-1 l-box\">\n          <div class=\"dd-footer__address dd-u-1-1\">\n            <address>{{ Company Address }}</address>\n          </div>\n          <div class=\"dd-footer__phone dd-u-1-1\">\n            <a href=\"tel:555-555-5555\" title=\"Call 555-555-5555\">555-555-5555</a>\n          </div>\n          <div class=\"dd-footer__email dd-u-1-1\">\n            <a href=\"mailto:info@company.com\" title=\"Send email to info@company.com\">info@company.com</a>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"dd-footer__navigation navigation -social-menu dd-u-1-1 dd-u-lg-8-24 l-box\">\n      <nav class=\"navigation\" role=\"navigation\" itemscope itemtype=\"https://schema.org/SiteNavigationElement\" aria-label=\"Footer navigation\">\n        <ul class=\"menu\">\n          <li class=\"menu-item\">\n            <a href=\"https://www.facebook.com/\" itemprop=\"url\" class=\"-facebook\"><span class=\"visually-hidden\">Facebook</span></a>\n          </li>\n          <li class=\"menu-item\">\n            <a href=\"https://www.instagram.com/\" itemprop=\"url\" class=\"-instagram\"><span class=\"visually-hidden\">Instagram</span></a>\n          </li>\n          <li class=\"menu-item\">\n            <a href=\"https://twitter.com/\" itemprop=\"url\" class=\"-x\"><span class=\"visually-hidden\">Twitter</span></a>\n          </li>\n        </ul>\n      </nav>\n    </div>\n  </div>\n  <div class=\"dd-g\">\n    <div class=\"dd-footer__copyright dd-u-1-1\">\n      <div class=\"l-box\">\n        {{ copyright goes here }}\n      </div>\n    </div>\n  </div>\n</footer>\n```"
