      </nav>\n      </div>\n      <div class=\"dd-header__search-icon dd-u-3-24 dd-u-sm-3-24 dd-u-md-3-24 dd-u-lg-4-24 -y-center -x-center\">\n        <button class=\"dd-search__toggle\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M0 0h24v24H0z\" fill=\"none\"></path><path fill=\"currentColor\" d=\"M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z\"></path></svg><span class=\"visually-hidden\">Search</span></button>\n      </div>\n      <div class=\"dd-header__menu-icon dd-u-3-24 dd-u-sm-3-24 dd-u-md-3-24 -y-center -x-center\">\n        <button class=\"dd-menu__toggle\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1em\" height=\"1em\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M0 0h24v24H0z\" fill=\"none\"></path><path fill=\"currentColor\" d=\"M3 4H21V6H3V4ZM3 11H21V13H3V11ZM3 18H21V20H3V18Z\"></path></svg><span class=\"visually-hidden\">Menu</span></button>\n      </div>\n    </div>\n  </div>\n  <div class=\"dd-search\">\n    <button class=\"dd-search__close\">- search</button>\n    <form action=\"\">\n      <label for=\"name\">Search<br />\n        <input type=\"text\" id=\"name\">\n      </label>\n    </form>\n  </div>\n</header>\n</div>"
