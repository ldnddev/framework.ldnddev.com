          "section_title": null,
          "section_class": "-full-lg",
          "item_box_class": "l-box",
          "sal": "no-animation",
          "columns": [
            {
              "id": "page-components-timeline-section-1-column-1",
              "width_class": "dd-u-1-1",
              "components": [
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "# Timeline"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "### Preview"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "<div class=\"dd-example\">\n<div class=\"dd-timeline\">\n  <div class=\"dd-timeline__content\">\n    <div class=\"dd-timeline__items dd-g\">\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n    </div>\n  </div>\n</div>\n</div>"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "### Code"
                },
                {
                  "component_type": "rich_text",
                  "parent_class": null,
                  "sal": "no-animation",
                  "parent_copy": "```html\n<div class=\"dd-timeline\">\n  <div class=\"dd-timeline__content\">\n    <div class=\"dd-timeline__items dd-g\">\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n      <!-- start timeline item -->\n      <div class=\"dd-timeline__item dd-u-1-1\">\n        <div class=\"dd-timeline__body dd-g\">\n          <div class=\"dd-timeline__image l-box dd-u-1-1\">\n            <img\n              src=\"https://dummyimage.com/600x400/000/fff\"\n              alt=\"slider alt tag for image\"\n              class=\"dd-img\"\n            />\n          </div>\n          <div class=\"dd-timeline__copy l-box dd-u-1-1\">\n            <div class=\"dd-timeline__year\">\n              Timeline item year\n            </div>\n            <div class=\"dd-timeline__title\">\n              Timeline item title\n            </div>\n              <div class=\"dd-timeline__copy\">\n                Timeline item copy\n              </div>\n          </div>\n        </div>\n      </div>\n      <!-- end timeline item -->\n    </div>\n  </div>\n</div>\n```"
                }
